# Example environment for the healthcare deviation (avvikelse) backend.
# Copy to .env.development.local (and .env.production.local for overrides when building or starting).
#
# IAF and VOF are two deployments of this same application and behave identically. They differ only in
# SUPPORTMANAGEMENT_NAMESPACE and the AD groups (AUTHORIZED_GROUPS, ADMIN_GROUP, DEVELOPER_GROUP,
# SUPERADMIN_GROUP, HEALTHCAREDEVIATION_HANDLER_ROLES), plus deployment plumbing: ports, URLs, SAML,
# BASE_URL_PREFIX and secrets. The values below are for IAF; VOF uses /vof where IAF uses /iaf.

# Environment
NODE_ENV=development
ENVIRONMENT=LOCAL
PORT=3001
BASE_URL_PREFIX=/iaf
API_BASE_URL=https://api-i-test.sundsvall.se
CLIENT_KEY={{INSERT CLIENT_KEY}}
CLIENT_SECRET={{INSERT CLIENT SECRET}}

# The investigation requires the Support Management sprint subscription.
SUPPORTMANAGEMENT_API_TARGET=sprint

# Overview lists and counts from the Support Management search index (sprint 17.0). Turn on only
# once the API team has rebuilt the namespace's index; errands created before it are missing until then.
SUPPORTMANAGEMENT_ERRAND_SEARCH=false

# SAML
SAML_CALLBACK_URL=http://localhost:3001/iaf/saml/login/callback
SAML_LOGOUT_CALLBACK_URL=http://localhost:3001/iaf/saml/logout/callback
SAML_FAILURE_REDIRECT=http://localhost:3001/iaf/saml/login
SAML_SUCCESS_REDIRECT=http://localhost:3000/iaf
SAML_ENTRY_SSO=http://{{domain-to-sso}}/sso
SAML_LOGOUT_URL=http://{{domain-to-sso}}/logout
SAML_IDP_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"
SAML_ISSUER=passport-saml
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n{{INSERT_CERT}}\n-----END PRIVATE KEY-----\n"
SAML_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n{{INSERT_CERT}}\n-----END CERTIFICATE-----\n"

# Identity and application
AUTHORIZED_GROUPS="{{INSERT_AUTHORIZED_GROUP}}"
# DEVELOPER_GROUP, ADMIN_GROUP and SUPERADMIN_GROUP each take one AD group or a comma-separated list.
# The avvikelse handler groups belong in ADMIN_GROUP: it grants the edit permission that listing errands needs.
ADMIN_GROUP="{{INSERT_ADMIN_GROUP}}"
# Handler roles (required; the backend refuses to start without them): one entry per role, naming the AD
# group that holds it. One list serves three purposes:
# - "Tilldela handläggare" lists the members grouped by role.
# - The handover steps require a role of their assignee. The keys enhetschef, lex-ansvarig and
#   lex-utredare are referenced by those steps; renaming a key disables the step that needs it.
# - A role with "measures" registers measures: roleName is the namespace Role.name, measureGroup a group in
#   MeasureType.measureGroups, and "decides": true accepts the role's own measures on creation (every other
#   role registers proposals). Members of SUPERADMIN_GROUP hold every such role.
# Grants no login: every group here, and SUPERADMIN_GROUP, must also be in AUTHORIZED_GROUPS (the backend
# warns at startup otherwise). Description: frontend/src/supportmanagement/measures/README.md
HEALTHCAREDEVIATION_HANDLER_ROLES='[{"key":"enhetschef","label":"Enhetschef","group":"{{INSERT_ENHETSCHEF_GROUP}}","measures":{"roleName":"UNIT_MANAGER","measureGroup":"UNIT_MANAGER","decides":true}},{"key":"verksamhetschef","label":"Verksamhetschef","group":"{{INSERT_VERKSAMHETSCHEF_GROUP}}"},{"key":"lex-ansvarig","label":"LEX-ansvarig","group":"{{INSERT_LEX_ANSVARIG_GROUP}}","measures":{"roleName":"LEX_INVESTIGATOR","measureGroup":"SOL_LSS"}},{"key":"lex-utredare","label":"LEX-utredare","group":"{{INSERT_LEX_UTREDARE_GROUP}}","measures":{"roleName":"LEX_INVESTIGATOR","measureGroup":"SOL_LSS"}},{"key":"mas-mar","label":"MAS/MAR","group":"{{INSERT_HSL_GROUP}}","measures":{"roleName":"MAR_MAS","measureGroup":"HSL_MAS_MAR"}}]'
DEVELOPER_GROUP="{{INSERT_DEVELOPER_GROUP}}"
# Superadmins, who are also the avvikelse administrators: they hold every measure registration role in
# HEALTHCAREDEVIATION_HANDLER_ROLES.
SUPERADMIN_GROUP="{{INSERT_SUPERADMIN_GROUP}}"
MUNICIPALITY_ID=2281
DOMAIN=personal

# Encryption, diagnostics and CORS
SECRET_KEY={{INSERT SECRET KEY}}
SWAGGER_ENABLED=true
LOG_FORMAT=dev
LOG_DIR=../../data/logs
ORIGIN=http://localhost:3000
CREDENTIALS=true

# Support Management
SUPPORTMANAGEMENT_SENDER_EMAIL=name@sundsvall.se
SUPPORTMANAGEMENT_SENDER_SMS=070-...
# HEALTHCAREDEVIATIONIAF for IAF, HEALTHCAREDEVIATIONVOF for VOF.
SUPPORTMANAGEMENT_NAMESPACE=HEALTHCAREDEVIATIONIAF

# Investigation access comes from Support Management Sprint /errands/{errandId}/access.
# Configure document keys and levels centrally in Support Management / AccessMapper.
