# Copy to .env.local. IAF and VOF run this same frontend; a deployment differs from the other only in where it
# is served (port, base path, the backend it talks to) and the name it shows. Everything that tells IAF from VOF
# apart - the Support Management namespace and the AD groups - is the backend's configuration.
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/iaf
DOMAIN_NAME=localhost
NEXT_PUBLIC_APPLICATION_NAME="Avvikelse IAF"
NEXT_PUBLIC_BASEPATH=/iaf
NEXT_PUBLIC_ENVIRONMENT=TEST
HEALTH_AUTH=false
HEALTH_USERNAME=''
HEALTH_PASSWORD=''
NEXT_PUBLIC_MUNICIPALITY_ID=2281
NEXT_PUBLIC_SHOW_DEPLOY_INFO=false
NEXT_PUBLIC_PROTECTED_ROUTES=/oversikt,/registrera,/arende

# Relaterade rapporter shows example reports instead of the brukare's own, for a test environment where
# CaseStatus cannot see the application's reports. Never on in production.
NEXT_PUBLIC_USE_RELATED_REPORTS_MOCK=false
