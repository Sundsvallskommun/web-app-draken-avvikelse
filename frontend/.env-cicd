# ===========================================
# Build-time placeholders for CI/CD
# These are replaced at runtime by entrypoint.sh
# ===========================================

# --- Non NEXT_PUBLIC (replaced explicitly) ---
DOMAIN_NAME=DOMAIN_NAME_PLACEHOLDER
BASE_PATH=BASE_PATH_PLACEHOLDER
ADMIN_URL=ADMIN_URL_PLACEHOLDER
HEALTH_AUTH="false"
HEALTH_USERNAME=HEALTH_USERNAME_PLACEHOLDER
HEALTH_PASSWORD=HEALTH_PASSWORD_PLACEHOLDER

# --- Instance ---
NEXT_PUBLIC_APPLICATION_NAME=NEXT_PUBLIC_APPLICATION_NAME_PLACEHOLDER
NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL_PLACEHOLDER
NEXT_PUBLIC_BASEPATH=/NEXT_PUBLIC_BASEPATH_PLACEHOLDER
NEXT_PUBLIC_ENVIRONMENT=NEXT_PUBLIC_ENVIRONMENT_PLACEHOLDER
NEXT_PUBLIC_PROTECTED_ROUTES=NEXT_PUBLIC_PROTECTED_ROUTES_PLACEHOLDER
NEXT_PUBLIC_SHOW_DEPLOY_INFO=NEXT_PUBLIC_SHOW_DEPLOY_INFO_PLACEHOLDER

# --- Test environment only ---
NEXT_PUBLIC_USE_RELATED_REPORTS_MOCK=NEXT_PUBLIC_USE_RELATED_REPORTS_MOCK_PLACEHOLDER
