{
  "name": "draken-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "dotenv -e .env.local -- next build",
    "build:local": "node ../scripts/generate-deploy-info.js && dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- next start",
    "generate:contracts": "dotenv -e .env.local npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "lint:strict": "eslint src/ e2e/ --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs}\"",
    "type-check": "tsc --pretty --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json --pretty --noEmit",
    "knip": "knip",
    "knip:production": "knip --production",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test:e2e": "dotenv -e .env.local -- playwright test --project=avvikelse",
    "test:e2e:ui": "dotenv -e .env.local -- playwright test --project=avvikelse --ui",
    "test:e2e:schema-lab": "dotenv -e .env.local -- playwright test --project=schema-lab",
    "screenshots:readme": "dotenv -e .env.local -- playwright test --project=readme",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs}\"",
    "test:json": "vitest run src/common/components/json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@sk-web-gui/button": "2.1.11",
    "@sk-web-gui/core": "4.6.1",
    "@sk-web-gui/react": "3.1.2",
    "@sk-web-gui/table": "3.2.20",
    "@sk-web-gui/text-editor": "2.1.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "ajv": "^8.17.1",
    "axios": "^1.15.2",
    "dayjs": "^1.11.13",
    "envalid": "^8.1.0",
    "i18next": "^24.2.3",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "0.575.0",
    "next": "16.2.6",
    "next-i18n-router": "^5.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^15.6.1",
    "sanitize-html": "^2.17.0",
    "sass": "^1.90.0",
    "sharp": "^0.34.3",
    "underscore.string": "^3.3.6",
    "usehooks-ts": "^3.1.1",
    "uuid": "^9.0.0",
    "yup": "1.7.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "14.0.0",
    "@types/node": "^20.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.11.0",
    "@types/underscore.string": "^0.0.41",
    "@types/uuid": "^9.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^26.1.0",
    "knip": "^6.14.2",
    "postcss": "^8.5.10",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "prettier": "^2.4.1",
    "swagger-typescript-api": "13.2.8",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "resolutions": {
    "form-data": "^4.0.4",
    "react-hook-form": "^7.71.2"
  }
}
