    "ui:sections": [
      {
        "id": "background",
        "title": "Bakgrund",
        "icon": "info",
        "defaultOpen": true,
        "fields": ["investigator", "reportedEventDescription", "reportSummary", "reportReceivedDate"]
      },
      {
        "id": "what-happened",
        "title": "Vad har hänt?",
        "icon": "history",
        "defaultOpen": true,
        "fields": [
          "reportedMisconduct",
          "occurrenceTime",
          "discovery",
          "occurrenceOperation",
          "affectedPersons",
          "consequences",
          "gatheredInformation",
          "courseOfEvents",
          "timeline",
          "previousOccurrences",
          "eventAnalysis"
        ]
      },
      {
        "id": "why",
        "title": "Varför har det hänt?",
        "icon": "circle-alert",
        "defaultOpen": true,
        "description": "När händelser inträffar och bedömningen är att nämnden avvikit från aktuella kvalitetskrav ska bakomliggande orsaker till det inträffade identifieras.",
        "footnote": "Utredarens förslag på åtgärder för att förhindra att liknande inträffar igen registreras i fliken Åtgärder.",
        "fields": [
          "causeAreas",
          "recurrenceRisk",
          "immediateActions",
          "preventiveActions",
          "otherFindings",
          "individualNotified",
          "representativeNotified",
          "documentedInRecord",
          "feedbackGiven",
          "requiresPoliceReport"
        ]
      },
      {
        "id": "decision-proposal",
        "title": "Förslag till beslut",
        "icon": "gavel",
        "defaultOpen": true,
        "fields": ["proposedMisconductDegree", "proposalMotivation"]
      },
      {
        "id": "categorization",
        "title": "Kategorisering",
        "icon": "menu",
        "defaultOpen": true,
        "fields": ["legalBases", "$external:errandClassification"]
      },
      {
        "id": "report",
        "title": "Avsluta utredning och skapa rapport",
        "icon": "file-text",
        "defaultOpen": true,
        "fields": ["completed", "$external:investigationReport", "reports"]
      }
    ],
